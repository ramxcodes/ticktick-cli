{
  "name": "ticktick-cli",
  "version": "2.0.0",
  "description": "Reliable TickTick CLI for humans, scripts, and AI agents",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ramxcodes/ticktick-cli.git"
  },
  "bin": {
    "ticktick": "./src/cli.ts"
  },
  "files": [
    "src",
    "README.md",
    "SKILL.md",
    "MIGRATION.md",
    "CHANGELOG.md"
  ],
  "engines": {
    "bun": ">=1.1.0"
  },
  "scripts": {
    "ticktick": "bun src/cli.ts",
    "typecheck": "tsc --noEmit",
    "test": "bun test tests/unit",
    "test:e2e": "bun test tests/e2e",
    "test:all": "bun test",
    "build": "bun build src/cli.ts --compile --outfile dist/ticktick",
    "check": "tsc --noEmit && bun test tests/unit",
    "test:live": "bun tests/live/live-check.ts"
  },
  "dependencies": {
    "commander": "^12.1.0"
  },
  "devDependencies": {
    "@types/bun": "^1.1.0",
    "typescript": "^5.6.0"
  }
}
